rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to get current user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if user is an admin
    // We use .get() with a default to avoid errors if the field is missing
    function isAdmin() {
      return isAuthenticated() && getUserData().get('role', 'user') == 'admin';
    }

    // User profiles
    match /users/{userId} {
      // Users can read/write their own profile
      // Admins can read any profile. We use a direct check here to avoid recursion.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        getUserData().get('role', 'user') == 'admin'
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      // For list queries, the query MUST include a filter for userId unless the user is an admin
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Purchase Requests
    match /purchase_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Product collections - Read for everyone, Write for admins
    match /dataPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /virtualNumbers/{numberId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Sociallogs/{logId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}