
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is an admin
    // We use a more robust check that handles potential evaluation errors
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{userId} {
      // Users can read/write their own profile; admins can do anything
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Transactions
    match /transactions/{transactionId} {
      // Non-admins can only read/list their own transactions
      // Admins can read/list everything
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource == null && request.query.filters.userId == request.auth.uid)
      );
      
      // Users can create their own transactions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Only admins can update or delete
      allow update, delete: if isAdmin();
    }

    // Purchase Requests
    match /purchase_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource == null && request.query.filters.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Product collections
    match /dataPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /virtualNumbers/{numberId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Sociallogs/{logId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
