
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is an admin
    // We use a simple get() to avoid recursive rule checks if possible
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Purchase Requests
    match /purchase_requests/{requestId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Wallet Funding Requests
    match /wallet_funding_requests/{requestId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Social Log private inventory
    match /social_log_inventory/{inventoryId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.soldTo == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Product collections
    match /dataPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /virtualNumbers/{numberId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Sociallogs/{logId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
