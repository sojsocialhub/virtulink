rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if user is an admin
    // This looks up the user's role in the 'users' collection
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users need write access to update their own profile (e.g., wallet balance deductions)
      allow write: if isOwner(userId) || isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      // Users can only read their own transactions. Admins can read everything.
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Users can create their own transactions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only admins can modify or delete transaction logs
      allow update, delete: if isAdmin();
    }

    // Funding Requests
    match /fundRequests/{requestId} {
      // Users can see their own requests. Admins see all.
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Users can submit their own funding requests
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only admins can approve/reject (update) or delete requests
      allow update, delete: if isAdmin();
    }

    // Product collections (Data plans, Virtual Numbers, Social Logs)
    // Publicly readable so guests can see the catalog
    match /dataPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /virtualNumbers/{numberId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /socialLogs/{logId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}