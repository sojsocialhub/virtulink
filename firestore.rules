rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is an admin
    // This looks up the user's role in the 'users' collection
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{userId} {
      // Users can read/write their own profile; admins can do anything
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      // For single document reads (get) and collection queries (list)
      // Standard users must match their userId; admins have full access
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Users can create their own transactions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Only admins can update or delete
      allow update, delete: if isAdmin();
    }

    // Purchase Requests
    match /purchase_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Product collections - Read for everyone, Write for admins
    match /dataPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /virtualNumbers/{numberId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Sociallogs/{logId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}